{
  "name": "memoize-one",
  "version": "6.0.0",
  "description": "A memoization library which only remembers the latest invocation",
  "author": "Alex Reardon <alexreardon@gmail.com>",
  "license": "MIT",
  "keywords": [
    "memoize",
    "memoization",
    "cache",
    "performance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alexreardon/memoize-one.git"
  },
  "bugs": {
    "url": "https://github.com/alexreardon/memoize-one/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/memoize-one.d.ts",
      "default": "./dist/memoize-one.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/memoize-one.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "size-limit": [
    {
      "path": "dist/memoize-one.js",
      "limit": "250 B"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/benchmark": "^2.1.1",
    "@types/lodash.isequal": "^4.5.5",
    "@types/lodash.memoize": "^4.1.6",
    "@types/node": "^22.20.5",
    "benchmark": "^2.1.4",
    "fast-memoize": "^2.5.2",
    "lodash.isequal": "^4.5.0",
    "lodash.memoize": "^4.1.2",
    "markdown-table": "^3.0.1",
    "mem": "^9.0.1",
    "memoizee": "^0.4.15",
    "moize": "^6.1.0",
    "nanocolors": "^0.2.9",
    "ora": "^6.0.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.0",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "validate": "npm run format:check && npm run lint && npm run typecheck",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:size": "npm run build && size-limit",
    "build": "npm run build:clean && tsc -p tsconfig.build.json",
    "build:clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "perf": "node ./benchmarks/shallow-equal.ts",
    "perf:library-comparison": "npm run build && node ./benchmarks/library-comparison.js",
    "prepublishOnly": "npm run build"
  }
}
