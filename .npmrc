# Do not run install scripts from dependencies.
# Note: this also skips our own lifecycle scripts (such as prepublishOnly),
# so a manual `npm publish` would not build. Publish only through
# .github/workflows/release.yml, which builds and checks the package first.
ignore-scripts=true
# Only install versions that have been published for at least 7 days.
# Needs a recent npm 11 (Node.js 24 ships one); older npm ignores it.
min-release-age=7
